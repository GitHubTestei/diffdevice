-----------------------------------------------------------
-- Main Loop
-----------------------------------------------------------
local renderConnection = nil

ActionButton.MouseButton1Click:Connect(function()
    isRunning = not isRunning

    if isRunning then
        ActionButton.Text = "STOP"
        ActionButton.BackgroundColor3 = Color3.fromRGB(150, 50, 50)

        local lastUpdate    = 0
        local hue           = 0
        local useFirstOutfit= true   -- alternates between outfit1 / outfit2
        local currentGender = "" -- starts as Female, swaps to Male

        renderConnection = RunService.RenderStepped:Connect(function()
            if not isRunning then return end

            local now = tick()
            local requiredDelay = (100 - smoothnessPercent * smoothMultiplier) * 0.002

            if (now - lastUpdate) < requiredDelay then return end
            lastUpdate = now

            -- Pick base outfit
            local base = useFirstOutfit and outfit1 or outfit2

            -- Skin / hair defaults
            local currentSkin = useFirstOutfit and "000000" or "FFDCBD"
            local currentHair = "000000"

            -- Rainbow override
            if rainbowEnabled then
                hue = (now * (rainbowSpeed * 0.05)) % 1
                local sat = pastelEnabled and 0.4 or 1
                local hex = colorToHex(Color3.fromHSV(hue, sat, 1))
                if targetMode == "Hair" then
                    currentHair = hex
                elseif targetMode == "Skin" then
                    currentSkin = hex
                elseif targetMode == "Both" then
                    currentHair = hex
                    currentSkin = hex
                end
            end

            -- Resolve hair and face (randomize overrides fixed values)
            local resolvedHair = randomizeEnabled and pick(randomHairs) or base.HairId
            local resolvedFace = randomizeEnabled and pick(randomFaces) or base.FaceId

            -- Resolve gender
            local resolvedGender
            if genderSwapEnabled then
                resolvedGender = currentGender
            else
                resolvedGender = base.Gender
            end

            local payload = {
                ["Bio"]        = base.Bio,
                ["Archetype"]  = base.Archetype,
                ["Archetype2"] = base.Archetype2,
                ["Forename"]   = base.Forename,
                ["HairId"]     = resolvedHair,
                ["HairColor"]  = currentHair,
                ["SkinColor"]  = currentSkin,
                ["FaceId"]     = resolvedFace,
                ["Gender"]     = resolvedGender,
                ["Surname"]    = generateRandomString(),
            }

            pcall(function()
                CharacterService:InvokeServer(payload)
            end)

            -- Advance swap states
            if swapEnabled then
                useFirstOutfit = not useFirstOutfit
            end

            if genderSwapEnabled then
                currentGender = (currentGender == "") and "" or ""
            end
        end)

    else
        ActionButton.Text = "START"
        ActionButton.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
        if renderConnection then
            renderConnection:Disconnect()
            renderConnection = nil
        end
    end
end)
