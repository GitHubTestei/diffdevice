-- Frame Loop Variable
local renderConnection = nil

ActionButton.MouseButton1Click:Connect(function()
    isRunning = not isRunning
    
    if isRunning then
        ActionButton.Text = "STOP"
        ActionButton.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
        
        local lastUpdate = 0
        local hue = 0
        
        renderConnection = RunService.RenderStepped:Connect(function()
            if not isRunning then return end
            
            local now = tick()
            -- Smoothness frequency delay calculation
            local requiredDelay = (100 - smoothnessPercent) * 0.002
            
            if (now - lastUpdate) >= requiredDelay then
                lastUpdate = now
                
                -- Updated default fallback static colors matching your argument fields
                local currentSkin = "ffdcbd"
                local currentHair = "FFFFFF"
                
                if rainbowEnabled then
                    hue = (now * (rainbowSpeed * 0.05)) % 1
                    
                    local saturation = pastelEnabled and 0.4 or 1
                    local value = 1
                    
                    local hexColor = colorToHex(Color3.fromHSV(hue, saturation, value))
                    
                    if targetMode == "Hair" then
                        currentHair = hexColor
                    elseif targetMode == "Skin" then
                        currentSkin = hexColor
                    elseif targetMode == "Both" then
                        currentHair = hexColor
                        currentSkin = hexColor
                    end
                end
                
                pcall(function()
                    CharacterService:InvokeServer({
                        ["Bio"] = "Testing",
                        ["Archetype"] = "Atisuto",
                        ["Archetype2"] = "Usagi",
                        ["Forename"] = "",
                        ["HairId"] = 106106436596888,
                        ["HairColor"] = currentHair,
                        ["SkinColor"] = currentSkin,
                        ["FaceId"] = 42678935827929,
                        ["Surname"] = ""
                    })
                end)
            end
        end)
    else
        ActionButton.Text = "START"
        ActionButton.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
        if renderConnection then
            renderConnection:Disconnect()
            renderConnection = nil
        end
    end
end)
